rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================
    // COMMON HELPERS
    // =====================================================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function adminPath() {
      return /databases/$(database)/documents/admin_users/$(request.auth.uid);
    }

    function isAdmin() {
      return signedIn()
        && exists(adminPath())
        && get(adminPath()).data.get('isActive', false) == true
        && get(adminPath()).data.get('role', '') == 'super_admin';
    }

    function validTimestamp(value) {
      return value is timestamp;
    }

    function validCreatedAt() {
      return request.resource.data.createdAt == request.time;
    }

    function validOptionalString(data, field) {
      return !(field in data) || data[field] is string;
    }

    function validOptionalBool(data, field) {
      return !(field in data)
        || data[field] == null
        || data[field] is bool;
    }

    function validOptionalNumber(data, field) {
      return !(field in data)
        || data[field] == null
        || data[field] is number;
    }

    function validOptionalTimestamp(data, field) {
      return !(field in data)
        || data[field] == null
        || data[field] is timestamp;
    }

    function validWalkerStatus(data) {
      return data.get('status', '') in [
        'in_progress',
        'under_review',
        'approved',
        'rejected',
        'correction_required',
        'suspended',
        'inactive',
        'left'
      ];
    }

    function validWalkerVerificationStatus(data) {
      return data.get('verificationStatus', '') in [
        'pending',
        'verified',
        'rejected',
        'correction_required'
      ];
    }

    function isApprovedWalker() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/walkers/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/walkers/$(request.auth.uid)
        ).data.get('isActive', false) == true
        && get(
          /databases/$(database)/documents/walkers/$(request.auth.uid)
        ).data.get('isApproved', false) == true;
    }

    // =====================================================
    // ADMIN WALKER DECISION VALIDATION
    // =====================================================

    function validAdminWalkerDecision() {
      let d = request.resource.data;

      return validWalkerStatus(d)
        && validWalkerVerificationStatus(d)
        && d.get('isApproved', false) is bool
        && d.get('isActive', false) is bool

        && (
          d.status != 'approved'
          || (
            d.verificationStatus == 'verified'
            && d.isApproved == true
            && d.isActive == true
          )
        )

        && (
          d.status != 'rejected'
          || (
            d.verificationStatus == 'rejected'
            && d.isApproved == false
            && d.isActive == false
          )
        )

        && (
          d.status != 'correction_required'
          || (
            d.verificationStatus == 'correction_required'
            && d.isApproved == false
            && d.isActive == false
          )
        )

        && (
          d.status != 'suspended'
          || (
            d.verificationStatus == 'verified'
            && d.isApproved == true
            && d.isActive == false
          )
        )

        && (
          d.status != 'in_progress'
          || (
            d.isApproved == false
            && d.isActive == false
          )
        )

        && (
          d.status != 'under_review'
          || (
            d.isApproved == false
            && d.isActive == false
          )
        )

        && (
          d.status != 'inactive'
          || d.isActive == false
        )

        && (
          d.status != 'left'
          || d.isActive == false
        );
    }

    function validWalkerDecisionReason() {
      let d = request.resource.data;

      return !('decisionReason' in d)
        || d.decisionReason == null
        || (
          d.decisionReason is string
          && d.decisionReason.size() <= 1000
        );
    }

    // =====================================================
    // ADMIN USERS
    // =====================================================

    match /admin_users/{adminUid} {

      allow get: if signedIn()
        && (
          request.auth.uid == adminUid
          || isAdmin()
        );

      allow list: if isAdmin();

      allow create, delete: if false;

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'name',
            'email',
            'role',
            'isActive',
            'updatedAt'
          ])
        && request.resource.data.get('role', '') in [
          'super_admin',
          'admin',
          'support'
        ]
        && request.resource.data.isActive is bool;
    }

    // =====================================================
    // CUSTOMER USERS
    // =====================================================

    match /users/{userId} {

      allow get: if isOwner(userId) || isAdmin();

      allow list: if isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'name',
          'phoneNumber',
          'email',
          'role',
          'dateOfBirth',
          'dob',
          'age',
          'photoUrl',
          'profileImage',
          'createdAt',
          'updatedAt',
          'language',
          'notificationEnabled'
        ])
        && request.resource.data.get('role', 'customer') == 'customer'
        && validOptionalString(request.resource.data, 'name')
        && validOptionalString(request.resource.data, 'phoneNumber')
        && validOptionalString(request.resource.data, 'email')
        && validOptionalString(request.resource.data, 'language')
        && validOptionalString(request.resource.data, 'photoUrl')
        && validOptionalString(request.resource.data, 'profileImage');

      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'name',
            'phoneNumber',
            'email',
            'dateOfBirth',
            'dob',
            'age',
            'photoUrl',
            'profileImage',
            'updatedAt',
            'language',
            'notificationEnabled'
          ])
        && request.resource.data.get('role', 'customer') == 'customer';

      allow delete: if false;

      // ===================================================
      // PETS
      // ===================================================

      match /pets/{petId} {

        allow get, list: if isOwner(userId) || isAdmin();

        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll([
            'name',
            'gender',
            'age',
            'breed',
            'size',
            'behaviour',
            'specialCare',
            'notes',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'name',
            'gender',
            'age',
            'breed',
            'size',
            'behaviour',
            'specialCare',
            'notes',
            'dob',
            'weight',
            'photoUrl',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.gender is string
          && request.resource.data.age is string
          && request.resource.data.breed is string
          && request.resource.data.size is string
          && request.resource.data.behaviour is list
          && request.resource.data.specialCare is list
          && request.resource.data.notes is string
          && validTimestamp(request.resource.data.createdAt)
          && validTimestamp(request.resource.data.updatedAt)
          && validOptionalString(request.resource.data, 'dob')
          && validOptionalNumber(request.resource.data, 'weight')
          && validOptionalString(request.resource.data, 'photoUrl');

        allow update: if isOwner(userId)
          && request.resource.data.keys().hasAll([
            'name',
            'gender',
            'age',
            'breed',
            'size',
            'behaviour',
            'specialCare',
            'notes',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'name',
            'gender',
            'age',
            'breed',
            'size',
            'behaviour',
            'specialCare',
            'notes',
            'dob',
            'weight',
            'photoUrl',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.name is string
          && request.resource.data.gender is string
          && request.resource.data.age is string
          && request.resource.data.breed is string
          && request.resource.data.size is string
          && request.resource.data.behaviour is list
          && request.resource.data.specialCare is list
          && request.resource.data.notes is string
          && request.resource.data.createdAt == resource.data.createdAt
          && validTimestamp(request.resource.data.updatedAt)
          && validOptionalString(request.resource.data, 'dob')
          && validOptionalNumber(request.resource.data, 'weight')
          && validOptionalString(request.resource.data, 'photoUrl');

        allow delete: if isOwner(userId) || isAdmin();
      }

      // ===================================================
      // SAVED ADDRESSES
      // ===================================================

      match /addresses/{addressId} {

        allow get, list: if isOwner(userId) || isAdmin();

        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll([
            'label',
            'flatHouse',
            'buildingSociety',
            'area',
            'landmark',
            'city',
            'pincode',
            'pickupInstructions',
            'latitude',
            'longitude',
            'isDefault',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'label',
            'flatHouse',
            'buildingSociety',
            'area',
            'landmark',
            'city',
            'pincode',
            'pickupInstructions',
            'latitude',
            'longitude',
            'isDefault',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.label is string
          && request.resource.data.flatHouse is string
          && request.resource.data.buildingSociety is string
          && request.resource.data.area is string
          && request.resource.data.landmark is string
          && request.resource.data.city is string
          && request.resource.data.pincode is string
          && request.resource.data.pickupInstructions is string
          && request.resource.data.isDefault is bool
          && validOptionalNumber(request.resource.data, 'latitude')
          && validOptionalNumber(request.resource.data, 'longitude')
          && validTimestamp(request.resource.data.createdAt)
          && validTimestamp(request.resource.data.updatedAt);

        allow update: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            'label',
            'flatHouse',
            'buildingSociety',
            'area',
            'landmark',
            'city',
            'pincode',
            'pickupInstructions',
            'latitude',
            'longitude',
            'isDefault',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.label is string
          && request.resource.data.flatHouse is string
          && request.resource.data.buildingSociety is string
          && request.resource.data.area is string
          && request.resource.data.landmark is string
          && request.resource.data.city is string
          && request.resource.data.pincode is string
          && request.resource.data.pickupInstructions is string
          && request.resource.data.isDefault is bool
          && validOptionalNumber(request.resource.data, 'latitude')
          && validOptionalNumber(request.resource.data, 'longitude')
          && request.resource.data.createdAt == resource.data.createdAt
          && validTimestamp(request.resource.data.updatedAt);

        allow delete: if isOwner(userId) || isAdmin();
      }

      // ===================================================
      // PICKUP ADDRESSES
      // ===================================================

      match /pickup_addresses/{addressId} {

        allow get, list: if isOwner(userId) || isAdmin();

        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly([
            'label',
            'address',
            'flatHouse',
            'buildingSociety',
            'area',
            'landmark',
            'city',
            'pincode',
            'pickupInstructions',
            'latitude',
            'longitude',
            'isDefault',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.label is string
          && request.resource.data.isDefault is bool
          && validOptionalString(request.resource.data, 'address')
          && validOptionalString(request.resource.data, 'flatHouse')
          && validOptionalString(request.resource.data, 'buildingSociety')
          && validOptionalString(request.resource.data, 'area')
          && validOptionalString(request.resource.data, 'landmark')
          && validOptionalString(request.resource.data, 'city')
          && validOptionalString(request.resource.data, 'pincode')
          && validOptionalString(request.resource.data, 'pickupInstructions')
          && validOptionalNumber(request.resource.data, 'latitude')
          && validOptionalNumber(request.resource.data, 'longitude');

        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // =====================================================
    // WALKERS — ZONE FIELDS REMOVED
    // =====================================================

    match /walkers/{walkerUid} {

      allow get: if isOwner(walkerUid)
        || isAdmin()
        || (
          signedIn()
          && resource.data.get('isActive', false) == true
          && resource.data.get('isApproved', false) == true
        );

      allow list: if isAdmin();

      allow create: if isOwner(walkerUid)
        && request.resource.data.keys().hasAll([
          'userId',
          'fullName',
          'phone',
          'dateOfBirth',
          'status',
          'isActive',
          'isApproved',
          'verificationStatus',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'userId',
          'fullName',
          'name',
          'phone',
          'phoneNumber',
          'email',
          'gender',
          'dateOfBirth',
          'city',
          'state',
          'area',
          'travelMode',
          'currentAddress',
          'kyc',
          'status',
          'isActive',
          'isApproved',
          'verificationStatus',
          'createdAt',
          'updatedAt',
          'submittedAt',
          'onboardingStep',
          'applicationSubmitted',
          'walkerId',
          'services',
          'rating',
          'availability',
          'address',
          'photoUrl',
          'profileImage',
          'documents',
          'fcmToken',
          'deviceTokens',
          'bankDetails',
          'emergencyContact'
        ])
        && request.resource.data.userId == walkerUid
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 3
        && request.resource.data.fullName.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.dateOfBirth is timestamp
        && request.resource.data.dateOfBirth <= request.time
        && request.resource.data.status == 'in_progress'
        && request.resource.data.isActive == false
        && request.resource.data.isApproved == false
        && request.resource.data.verificationStatus == 'pending'
        && request.resource.data.get('applicationSubmitted', false) == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validOptionalString(request.resource.data, 'email')
        && validOptionalString(request.resource.data, 'gender');

      allow update: if isOwner(walkerUid)
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'userId',
            'fullName',
            'name',
            'phone',
            'phoneNumber',
            'email',
            'gender',
            'dateOfBirth',
            'city',
            'state',
            'area',
            'travelMode',
            'currentAddress',
            'kyc',
            'updatedAt',
            'createdAt',
            'submittedAt',
            'onboardingStep',
            'applicationSubmitted',
            'services',
            'availability',
            'address',
            'photoUrl',
            'profileImage',
            'documents',
            'fcmToken',
            'deviceTokens',
            'bankDetails',
            'emergencyContact'
          ])
        && request.resource.data.get('userId', walkerUid) == walkerUid
        && request.resource.data.get('status', '') == resource.data.get('status', '')
        && request.resource.data.get('isActive', false) == resource.data.get('isActive', false)
        && request.resource.data.get('isApproved', false) == resource.data.get('isApproved', false)
        && request.resource.data.get('verificationStatus', '') == resource.data.get('verificationStatus', '')
        && validOptionalString(request.resource.data, 'fullName')
        && validOptionalString(request.resource.data, 'email')
        && validOptionalString(request.resource.data, 'gender')
        && validOptionalString(request.resource.data, 'phone')
        && validOptionalString(request.resource.data, 'phoneNumber')
        && (
          !('dateOfBirth' in request.resource.data)
          || request.resource.data.dateOfBirth is timestamp
        );

      allow update: if isOwner(walkerUid)
        && resource.data.get('applicationSubmitted', false) == false
        && request.resource.data.get('applicationSubmitted', false) == true
        && request.resource.data.get('status', '') == 'under_review'
        && request.resource.data.get('isActive', false) == false
        && request.resource.data.get('isApproved', false) == false
        && request.resource.data.get('verificationStatus', '') == 'pending'
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'applicationSubmitted',
            'submittedAt',
            'updatedAt',
            'onboardingStep'
          ])
        && request.resource.data.submittedAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'walkerId',
            'status',
            'isActive',
            'isApproved',
            'verificationStatus',
            'updatedAt',
            'decisionReason',
            'decisionBy',
            'decisionAt'
          ])
        && validAdminWalkerDecision()
        && validWalkerDecisionReason()
        && (
          !('decisionBy' in request.resource.data)
          || request.resource.data.decisionBy == request.auth.uid
        )
        && validOptionalTimestamp(request.resource.data, 'decisionAt');

      allow delete: if false;
    }

    // =====================================================
    // SUPPORT REQUESTS
    // =====================================================

    match /support_requests/{requestId} {

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'userId',
          'walkerId',
          'category',
          'message',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.walkerId == request.auth.uid
        && request.resource.data.category is string
        && request.resource.data.category in [
          'Application Status',
          'KYC Documents',
          'Personal Details',
          'Other'
        ]
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow get, list: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );

      allow update, delete: if isAdmin();
    }

    // =====================================================
    // BOOKING VALIDATION HELPERS
    // =====================================================

    function validBookingBase(bookingId) {
      return request.resource.data.keys().hasAll([
        'bookingId',
        'customerId',
        'walkType',
        'bookingPlan',
        'serviceType',
        'serviceName',
        'petName',
        'dogId',
        'petDetails',
        'pickupAddressId',
        'pickupAddress',
        'scheduledAt',
        'duration',
        'preferredTime',
        'status',
        'walkerId',
        'cancelRequest',
        'createdAt',
        'walkCount',
        'walkSchedules'
      ])
      && request.resource.data.keys().hasOnly([
        'bookingId',
        'customerId',
        'walkType',
        'bookingPlan',
        'serviceType',
        'serviceName',
        'petName',
        'dogId',
        'petDetails',
        'pickupAddressId',
        'pickupAddress',
        'scheduledAt',
        'duration',
        'preferredTime',
        'status',
        'walkerId',
        'cancelRequest',
        'createdAt',
        'walkCount',
        'walkSchedules',
        'frequency',
        'walksPerWeek',
        'walksPerDay',
        'planStatus',
        'dailyWalkTemplate',
        'selectedDates',
        'dateSchedules'
      ])
      && request.resource.data.bookingId == bookingId
      && request.resource.data.customerId == request.auth.uid
      && request.resource.data.walkType == 'scheduled'
      && request.resource.data.bookingPlan in [
        'one_time',
        'regular',
        'customize'
      ]
      && request.resource.data.serviceType in [
        'temporary_walk',
        'regular_walk',
        'custom_walk'
      ]
      && request.resource.data.serviceName is string
      && request.resource.data.petName is string
      && request.resource.data.dogId is string
      && request.resource.data.dogId.size() > 0
      && request.resource.data.petDetails is map
      && request.resource.data.pickupAddressId is string
      && request.resource.data.pickupAddressId.size() > 0
      && request.resource.data.pickupAddress is map
      && request.resource.data.scheduledAt is timestamp
      && request.resource.data.duration is string
      && request.resource.data.preferredTime is string
      && request.resource.data.status == 'pending'
      && request.resource.data.walkerId == null
      && request.resource.data.cancelRequest == null
      && validCreatedAt()
      && request.resource.data.walkCount is int
      && request.resource.data.walkCount >= 1
      && request.resource.data.walkCount <= 3
      && request.resource.data.walkSchedules is list
      && request.resource.data.walkSchedules.size()
        == request.resource.data.walkCount;
    }

    function validOneTimeBooking() {
      return request.resource.data.bookingPlan == 'one_time'
        && request.resource.data.serviceType == 'temporary_walk'
        && request.resource.data.walkCount == 1
        && !('frequency' in request.resource.data)
        && !('walksPerWeek' in request.resource.data)
        && !('walksPerDay' in request.resource.data)
        && !('planStatus' in request.resource.data)
        && !('dailyWalkTemplate' in request.resource.data)
        && !('selectedDates' in request.resource.data)
        && !('dateSchedules' in request.resource.data);
    }

    function validRegularBooking() {
      return request.resource.data.bookingPlan == 'regular'
        && request.resource.data.serviceType == 'regular_walk'
        && request.resource.data.frequency == 'daily'
        && request.resource.data.walksPerWeek == 7
        && request.resource.data.walksPerDay is int
        && request.resource.data.walksPerDay >= 1
        && request.resource.data.walksPerDay <= 3
        && request.resource.data.walkCount == request.resource.data.walksPerDay
        && request.resource.data.planStatus == 'pending_confirmation'
        && request.resource.data.dailyWalkTemplate is list
        && request.resource.data.dailyWalkTemplate.size() == request.resource.data.walkCount
        && !('selectedDates' in request.resource.data)
        && !('dateSchedules' in request.resource.data);
    }

    function validCustomBooking() {
      return request.resource.data.bookingPlan == 'customize'
        && request.resource.data.serviceType == 'custom_walk'
        && request.resource.data.walksPerDay is int
        && request.resource.data.walksPerDay >= 1
        && request.resource.data.walksPerDay <= 3
        && request.resource.data.walkCount == request.resource.data.walksPerDay
        && !('frequency' in request.resource.data)
        && !('walksPerWeek' in request.resource.data)
        && !('planStatus' in request.resource.data)
        && !('dailyWalkTemplate' in request.resource.data)
        && request.resource.data.selectedDates is list
        && request.resource.data.selectedDates.size() > 0
        && request.resource.data.dateSchedules is list
        && request.resource.data.dateSchedules.size() == request.resource.data.selectedDates.size();
    }

    // =====================================================
    // BOOKINGS
    // =====================================================

    match /bookings/{bookingId} {

      allow create: if signedIn()
        && validBookingBase(bookingId)
        && (
          validOneTimeBooking()
          || validRegularBooking()
          || validCustomBooking()
        );

      allow get, list: if isAdmin()
        || (
          signedIn()
          && resource.data.customerId == request.auth.uid
        )
        || (
          signedIn()
          && resource.data.walkerId == request.auth.uid
          && isApprovedWalker()
        );

      allow update: if signedIn()
        && resource.data.customerId == request.auth.uid
        && (
          (
            resource.data.status in [
              'pending',
              'confirmed',
              'assigned'
            ]
            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'cancelRequest',
                'updatedAt'
              ])
          )
          ||
          (
            resource.data.status == 'completed'
            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'rating',
                'review',
                'reviewedAt',
                'updatedAt'
              ])
          )
        );

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'walkerId',
            'updatedAt',
            'assignedAt',
            'startedAt',
            'completedAt',
            'cancelRequest',
            'adminNotes',
            'price',
            'totalPrice',
            'paymentStatus',
            'paymentId',
            'walkSchedules',
            'planStatus'
          ]);

      allow update: if isApprovedWalker()
        && resource.data.walkerId == request.auth.uid
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'updatedAt',
            'startedAt',
            'completedAt',
            'walkSchedules',
            'walkNotes',
            'peeCount',
            'poopCount',
            'distance',
            'durationActual'
          ]);

      allow delete: if isAdmin();
    }

    // =====================================================
    // WALK REQUESTS
    // =====================================================

    match /walk_requests/{requestId} {
      allow read, write: if false;
    }

    // =====================================================
    // WALKER REVIEWS
    // =====================================================

    match /walker_reviews/{reviewId} {

      allow get, list: if isAdmin()
        || (
          signedIn()
          && resource.data.customerId == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'bookingId',
          'customerId',
          'walkerId',
          'rating',
          'review',
          'createdAt'
        ])
        && request.resource.data.bookingId is string
        && request.resource.data.walkerId is string
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.review is string
        && request.resource.data.createdAt == request.time;

      allow update, delete: if isAdmin();
    }

    // =====================================================
    // SERVICE LOCATION BOUNDARY HELPERS
    // =====================================================

    function validBoundaryLocation(data) {
      return data.locationId is string
        && data.locationId.size() > 0
        && data.locationType in [
          'city',
          'area',
          'locality'
        ];
    }

    function validBoundaryPoints(points) {
      return points is list
        && points.size() >= 3
        && points.size() <= 10000;
    }

    function validBoundarySource(data) {
      return data.sourceType in [
          'governmentGis',
          'governmentCadastralMap',
          'importedGeoJson',
          'manuallyDrawn'
        ]
        && data.sourceName is string
        && data.sourceName.size() > 0
        && data.sourceReference is string
        && data.sourceReference.size() > 0;
    }

    function hasVerifiedBoundary(locationId, locationType, boundaryId) {
      return boundaryId is string
        && boundaryId.size() > 0
        && exists(
          /databases/$(database)/documents/service_location_boundaries/$(boundaryId)
        )
        && get(
          /databases/$(database)/documents/service_location_boundaries/$(boundaryId)
        ).data.locationId == locationId
        && get(
          /databases/$(database)/documents/service_location_boundaries/$(boundaryId)
        ).data.locationType == locationType
        && get(
          /databases/$(database)/documents/service_location_boundaries/$(boundaryId)
        ).data.verificationStatus == 'verified'
        && get(
          /databases/$(database)/documents/service_location_boundaries/$(boundaryId)
        ).data.points is list
        && get(
          /databases/$(database)/documents/service_location_boundaries/$(boundaryId)
        ).data.points.size() >= 3
        && get(
          /databases/$(database)/documents/service_location_boundaries/$(boundaryId)
        ).data.sourceName is string
        && get(
          /databases/$(database)/documents/service_location_boundaries/$(boundaryId)
        ).data.sourceName.size() > 0
        && get(
          /databases/$(database)/documents/service_location_boundaries/$(boundaryId)
        ).data.sourceReference is string
        && get(
          /databases/$(database)/documents/service_location_boundaries/$(boundaryId)
        ).data.sourceReference.size() > 0
        && get(
          /databases/$(database)/documents/service_location_boundaries/$(boundaryId)
        ).data.verifiedBy is string
        && get(
          /databases/$(database)/documents/service_location_boundaries/$(boundaryId)
        ).data.verifiedAt is timestamp;
    }

    // =====================================================
    // SERVICE LOCATION BOUNDARIES
    // =====================================================

    match /service_location_boundaries/{boundaryId} {

      allow get, list: if isAdmin();

      // Create a pending boundary.
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
          'locationId',
          'locationType',
          'points',
          'sourceType',
          'sourceName',
          'sourceReference',
          'verificationStatus',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'locationId',
          'locationType',
          'points',
          'sourceType',
          'sourceName',
          'sourceReference',
          'verificationStatus',
          'verifiedBy',
          'verifiedAt',
          'verificationNotes',
          'createdAt',
          'updatedAt'
        ])
        && validBoundaryLocation(request.resource.data)
        && validBoundaryPoints(request.resource.data.points)
        && validBoundarySource(request.resource.data)
        && request.resource.data.verificationStatus == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.get('verifiedBy', null) == null
        && request.resource.data.get('verifiedAt', null) == null
        && request.resource.data.get('verificationNotes', null) == null;

      // Edit pending/rejected boundary and send it back to pending.
      allow update: if isAdmin()
        && resource.data.verificationStatus in [
          'pending',
          'rejected'
        ]
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'points',
            'sourceType',
            'sourceName',
            'sourceReference',
            'verificationStatus',
            'verifiedBy',
            'verifiedAt',
            'verificationNotes',
            'updatedAt'
          ])
        && validBoundaryLocation(request.resource.data)
        && validBoundaryPoints(request.resource.data.points)
        && validBoundarySource(request.resource.data)
        && request.resource.data.locationId == resource.data.locationId
        && request.resource.data.locationType == resource.data.locationType
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.verificationStatus == 'pending'
        && request.resource.data.get('verifiedBy', null) == null
        && request.resource.data.get('verifiedAt', null) == null
        && request.resource.data.get('verificationNotes', null) == null
        && request.resource.data.updatedAt == request.time;

      // Verify a pending boundary.
      allow update: if isAdmin()
        && resource.data.verificationStatus == 'pending'
        && request.resource.data.verificationStatus == 'verified'
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'verificationStatus',
            'verifiedBy',
            'verifiedAt',
            'verificationNotes',
            'updatedAt'
          ])
        && validBoundaryLocation(request.resource.data)
        && request.resource.data.locationId == resource.data.locationId
        && request.resource.data.locationType == resource.data.locationType
        && request.resource.data.points == resource.data.points
        && request.resource.data.sourceType == resource.data.sourceType
        && request.resource.data.sourceName == resource.data.sourceName
        && request.resource.data.sourceReference == resource.data.sourceReference
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.verifiedBy == request.auth.uid
        && request.resource.data.verifiedAt == request.time
        && request.resource.data.verificationNotes is string
        && request.resource.data.verificationNotes.size() > 0
        && request.resource.data.updatedAt == request.time;

      // Reject a pending boundary.
      allow update: if isAdmin()
        && resource.data.verificationStatus == 'pending'
        && request.resource.data.verificationStatus == 'rejected'
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'verificationStatus',
            'verifiedBy',
            'verifiedAt',
            'verificationNotes',
            'updatedAt'
          ])
        && validBoundaryLocation(request.resource.data)
        && request.resource.data.locationId == resource.data.locationId
        && request.resource.data.locationType == resource.data.locationType
        && request.resource.data.points == resource.data.points
        && request.resource.data.sourceType == resource.data.sourceType
        && request.resource.data.sourceName == resource.data.sourceName
        && request.resource.data.sourceReference == resource.data.sourceReference
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.verifiedBy == request.auth.uid
        && request.resource.data.verifiedAt == null
        && request.resource.data.verificationNotes is string
        && request.resource.data.verificationNotes.size() > 0
        && request.resource.data.updatedAt == request.time;

      // A verified boundary cannot be deleted.
      allow delete: if isAdmin()
        && resource.data.verificationStatus != 'verified';
    }

    // =====================================================
    // SERVICE LOCATION NAME INDEXES
    // =====================================================

    match /service_location_name_indexes/{indexId} {

      allow get, list: if isAdmin();

      allow create, update, delete: if isAdmin();
    }

    // =====================================================
    // SERVICE COUNTRIES
    // =====================================================

    match /service_countries/{countryId} {

      allow get, list: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'name',
          'code',
          'isActive',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.code is string
        && request.resource.data.isActive is bool;

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'name',
            'code',
            'isActive',
            'updatedAt'
          ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.code is string
        && request.resource.data.isActive is bool;

      allow delete: if false;
    }

    // =====================================================
    // SERVICE STATES
    // =====================================================

    match /service_states/{stateId} {

      allow get, list: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'countryId',
          'name',
          'isActive',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.countryId is string
        && request.resource.data.countryId.size() > 0
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.isActive is bool;

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'countryId',
            'name',
            'isActive',
            'updatedAt'
          ])
        && request.resource.data.countryId is string
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.isActive is bool;

      allow delete: if false;
    }

    // =====================================================
    // SERVICE CITIES
    // Active city requires its own verified polygon boundary.
    // =====================================================

    match /service_cities/{cityId} {

      allow get, list: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'countryId',
          'stateId',
          'name',
          'boundary',
          'boundarySource',
          'boundaryVerified',
          'verifiedBoundaryId',
          'isServiceActive',
          'createdAt',
          'updatedAt',
          'state',
          'country'
        ])
        && request.resource.data.countryId is string
        && request.resource.data.stateId is string
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.isServiceActive is bool
        && (
          !('boundary' in request.resource.data)
          || request.resource.data.boundary is list
        )
        && validOptionalString(request.resource.data, 'boundarySource')
        && validOptionalBool(request.resource.data, 'boundaryVerified')
        && validOptionalString(request.resource.data, 'verifiedBoundaryId')
        && validOptionalString(request.resource.data, 'state')
        && validOptionalString(request.resource.data, 'country')
        && (
          request.resource.data.isServiceActive == false
          || hasVerifiedBoundary(
            cityId,
            'city',
            request.resource.data.get('verifiedBoundaryId', '')
          )
        );

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'countryId',
            'stateId',
            'name',
            'boundary',
            'boundarySource',
            'boundaryVerified',
            'verifiedBoundaryId',
            'isServiceActive',
            'updatedAt',
            'state',
            'country'
          ])
        && request.resource.data.countryId is string
        && request.resource.data.stateId is string
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.isServiceActive is bool
        && (
          !('boundary' in request.resource.data)
          || request.resource.data.boundary is list
        )
        && validOptionalString(request.resource.data, 'boundarySource')
        && validOptionalBool(request.resource.data, 'boundaryVerified')
        && validOptionalString(request.resource.data, 'verifiedBoundaryId')
        && validOptionalString(request.resource.data, 'state')
        && validOptionalString(request.resource.data, 'country')
        && (
          request.resource.data.isServiceActive == false
          || hasVerifiedBoundary(
            cityId,
            'city',
            request.resource.data.get('verifiedBoundaryId', '')
          )
        );

      allow delete: if false;
    }

    // =====================================================
    // SERVICE AREAS
    // Active area requires its own verified polygon boundary.
    // =====================================================

    match /service_areas/{areaId} {

      allow get, list: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'countryId',
          'stateId',
          'cityId',
          'name',
          'boundary',
          'boundarySource',
          'boundaryVerified',
          'verifiedBoundaryId',
          'isServiceActive',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.countryId is string
        && request.resource.data.stateId is string
        && request.resource.data.cityId is string
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.isServiceActive is bool
        && (
          !('boundary' in request.resource.data)
          || request.resource.data.boundary is list
        )
        && validOptionalString(request.resource.data, 'boundarySource')
        && validOptionalBool(request.resource.data, 'boundaryVerified')
        && validOptionalString(request.resource.data, 'verifiedBoundaryId')
        && (
          request.resource.data.isServiceActive == false
          || hasVerifiedBoundary(
            areaId,
            'area',
            request.resource.data.get('verifiedBoundaryId', '')
          )
        );

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'countryId',
            'stateId',
            'cityId',
            'name',
            'boundary',
            'boundarySource',
            'boundaryVerified',
            'verifiedBoundaryId',
            'isServiceActive',
            'updatedAt'
          ])
        && request.resource.data.countryId is string
        && request.resource.data.stateId is string
        && request.resource.data.cityId is string
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.isServiceActive is bool
        && (
          !('boundary' in request.resource.data)
          || request.resource.data.boundary is list
        )
        && validOptionalString(request.resource.data, 'boundarySource')
        && validOptionalBool(request.resource.data, 'boundaryVerified')
        && validOptionalString(request.resource.data, 'verifiedBoundaryId')
        && (
          request.resource.data.isServiceActive == false
          || hasVerifiedBoundary(
            areaId,
            'area',
            request.resource.data.get('verifiedBoundaryId', '')
          )
        );

      allow delete: if false;
    }

    // =====================================================
    // SERVICE LOCALITIES
    // Locality polygon is optional.
    // =====================================================

    match /service_localities/{localityId} {

      allow get, list: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'countryId',
          'stateId',
          'cityId',
          'areaId',
          'name',
          'pincode',
          'boundary',
          'boundarySource',
          'boundaryVerified',
          'isServiceActive',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.countryId is string
        && request.resource.data.stateId is string
        && request.resource.data.cityId is string
        && request.resource.data.areaId is string
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && validOptionalString(request.resource.data, 'pincode')
        && (
          !('boundary' in request.resource.data)
          || request.resource.data.boundary is list
        )
        && validOptionalString(request.resource.data, 'boundarySource')
        && validOptionalBool(request.resource.data, 'boundaryVerified')
        && request.resource.data.isServiceActive is bool;

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'countryId',
            'stateId',
            'cityId',
            'areaId',
            'name',
            'pincode',
            'boundary',
            'boundarySource',
            'boundaryVerified',
            'isServiceActive',
            'updatedAt'
          ])
        && request.resource.data.countryId is string
        && request.resource.data.stateId is string
        && request.resource.data.cityId is string
        && request.resource.data.areaId is string
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && validOptionalString(request.resource.data, 'pincode')
        && (
          !('boundary' in request.resource.data)
          || request.resource.data.boundary is list
        )
        && validOptionalString(request.resource.data, 'boundarySource')
        && validOptionalBool(request.resource.data, 'boundaryVerified')
        && request.resource.data.isServiceActive is bool;

      allow delete: if false;
    }

    // =====================================================
    // SERVICE LOCATION IMPORTS
    // =====================================================

    match /service_location_imports/{importId} {

      allow get, list: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'source',
          'fileName',
          'status',
          'importedBy',
          'importedAt',
          'verificationStatus'
        ])
        && request.resource.data.source is string
        && request.resource.data.fileName is string
        && request.resource.data.status is string
        && request.resource.data.importedBy == request.auth.uid
        && request.resource.data.importedAt == request.time
        && request.resource.data.verificationStatus is string;

      allow update, delete: if false;
    }

    // =====================================================
    // CUSTOMERS COLLECTION
    // =====================================================

    match /customers/{customerId} {

      allow get: if isAdmin()
        || (
          signedIn()
          && resource.data.uid == request.auth.uid
        );

      allow list: if isAdmin();

      allow create, update, delete: if isAdmin();
    }

    // =====================================================
    // COUPONS
    // =====================================================

    match /coupons/{couponId} {

      allow get, list: if isAdmin()
        || resource.data.get('isActive', false) == true;

      allow create, update, delete: if isAdmin();
    }

    // =====================================================
    // PAYMENTS
    // =====================================================

    match /payments/{paymentId} {

      allow get, list: if isAdmin()
        || (
          signedIn()
          && resource.data.customerId == request.auth.uid
        );

      allow create, update, delete: if isAdmin();
    }

    // =====================================================
    // AUDIT LOGS
    // =====================================================

    match /audit_logs/{logId} {

      allow get, list: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
          'actorUid',
          'action',
          'targetType',
          'targetId',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'actorUid',
          'actorRole',
          'action',
          'targetType',
          'targetId',
          'reason',
          'beforeStatus',
          'afterStatus',
          'beforeVerificationStatus',
          'afterVerificationStatus',
          'beforeIsApproved',
          'afterIsApproved',
          'beforeIsActive',
          'afterIsActive',
          'createdAt',
          'metadata'
        ])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.get('actorRole', 'super_admin') == 'super_admin'
        && request.resource.data.action is string
        && request.resource.data.action in [
          'walker_approved',
          'walker_rejected',
          'walker_correction_requested',
          'walker_suspended',
          'walker_reactivated',
          'walker_document_replaced',
          'walker_profile_updated'
        ]
        && request.resource.data.targetType == 'walker'
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && request.resource.data.createdAt == request.time
        && validOptionalString(request.resource.data, 'reason')
        && validOptionalString(request.resource.data, 'beforeStatus')
        && validOptionalString(request.resource.data, 'afterStatus')
        && validOptionalString(request.resource.data, 'beforeVerificationStatus')
        && validOptionalString(request.resource.data, 'afterVerificationStatus')
        && validOptionalBool(request.resource.data, 'beforeIsApproved')
        && validOptionalBool(request.resource.data, 'afterIsApproved')
        && validOptionalBool(request.resource.data, 'beforeIsActive')
        && validOptionalBool(request.resource.data, 'afterIsActive');

      allow update, delete: if false;
    }

    // =====================================================
    // DEFAULT DENY
    // =====================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
