rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isValidJpeg(maxBytes, expectedUserId, expectedDocumentType) {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= maxBytes
        && request.resource.contentType == 'image/jpeg'
        // Metadata is a consistency check only. Path + auth UID are the
        // authorization boundary; client metadata is never trusted as identity.
        && request.resource.metadata.userId == expectedUserId
        && request.resource.metadata.documentType == expectedDocumentType;
    }

    // Partner App: LiveSelfieScreen uploads only timestamped JPEG selfies.
    match /walker_selfies/{uid}/{fileName} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && resource == null
        && fileName.matches('selfie_[0-9]+[.]jpg')
        && isValidJpeg(10 * 1024 * 1024, uid, 'selfie');

      // Client-side deletion is intentionally denied. Retention/removal must
      // use an explicitly authorized backend process.
      allow delete: if false;
    }

    // Partner App: KycDocumentsScreen uploads Aadhaar front/back and PAN JPEGs.
    match /walker_documents/{uid}/{fileName} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && resource == null
        && (
          fileName.matches('aadhaar_front_[0-9]+[.]jpg')
          || fileName.matches('aadhaar_back_[0-9]+[.]jpg')
          || fileName.matches('pan_card_[0-9]+[.]jpg')
        )
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg'
        && request.resource.metadata.userId == uid
        && (
          (
            fileName.matches('aadhaar_front_[0-9]+[.]jpg')
            && request.resource.metadata.documentType == 'aadhaar_front'
          )
          || (
            fileName.matches('aadhaar_back_[0-9]+[.]jpg')
            && request.resource.metadata.documentType == 'aadhaar_back'
          )
          || (
            fileName.matches('pan_card_[0-9]+[.]jpg')
            && request.resource.metadata.documentType == 'pan_card'
          )
        );

      // Client-side deletion is intentionally denied. Retention/removal must
      // use an explicitly authorized backend process.
      allow delete: if false;
    }

    // Default deny for every other object path, including public access.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
